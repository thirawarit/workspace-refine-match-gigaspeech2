# Copy to .env and fill in. .env is gitignored; this template is not.
#
#   cp .env.example .env
#   chmod 600 .env
#
# setup_and_run.sh sources .env automatically when it exists, so the token
# reaches both the dependency sync and the run itself.

# HuggingFace access token — needed only if the model repo is gated or private.
# Create one at https://huggingface.co/settings/tokens (read scope is enough).
HF_TOKEN=

# Optional: override where the multi-GB model checkpoint is cached.
# Defaults to <repo>/.hf-cache, deliberately not ~/.cache, which may sit on a
# smaller filesystem.
# ASR_HF_HOME=/path/with/space/.hf-cache
